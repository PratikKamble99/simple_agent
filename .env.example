# Copy to .env and adjust. All values are optional; defaults live in app/core/config.py.
APP_NAME=ai-agent-fastapi
APP_VERSION=0.1.0
ENVIRONMENT=dev
DEBUG=false
API_V1_PREFIX=/api/v1

# Database. The +asyncpg driver is required - a plain postgresql:// URL
# tries to load psycopg and fails, because the engine is async.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=5.0

# Set to run the database tests; they are skipped when this is unset.
# Point it at a THROWAWAY database - the fixtures drop and recreate every table.
TEST_DATABASE_URL=

# RAG. Only credentials and deployment-specific names are configurable here.
# Chunk size/overlap, the upload limit and vector widths are constants in the
# code - see app/services/ingestion.py, app/api/v1/documents.py and
# app/services/embeddings.py.
# NOTE: the old misspelled QUADRANT_URL key is gone; use QDRANT_URL.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# Logging (console only; nothing is written to disk)
LOG_LEVEL=INFO
# Turn on to also emit uvicorn's own access log, which duplicates ours.
LOG_UVICORN_ACCESS=false
